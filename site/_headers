# Every revu.lol page is inside the web account trust boundary: the session
# cookie lives on clips.revu.lol, but any script running on revu.lol can call
# its credentialed /auth/web/* API. So no page may allow 'unsafe-inline'
# scripts. clip.html is the one page with an inline script, allowed by hash
# below: editing that script means recomputing BOTH sha256 values (LF and
# CRLF line endings), and tests/headers.test.mjs fails until they match.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://ddragon.leagueoflegends.com; media-src 'self' blob:; connect-src 'self' https://revu-proxy.lol-review.workers.dev https://clips.revu.lol https://api.github.com https://ddragon.leagueoflegends.com http://localhost:8787; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The clip watch page must stay frameable by the Twitter/X player card and
# reachable from localhost during wrangler dev. Pages serves it at the clean
# URL /clip (and redirects /clip.html there) — cover both. Detach the global
# CSP first: matched rules otherwise comma-join, and browsers enforce the
# intersection of joined policies (frame-ancestors 'none' would win).
/clip
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-Jc9g/O4YwfbHrfQc0DF3SOxgZYJeOWpvzs4UCTBAGAg=' 'sha256-XXaGqM9Ae0HM6ryYkvvlFVZf5x2T9gcrh9VcvPETxWE='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src https://clips.revu.lol http://localhost:8787 http://127.0.0.1:8787; connect-src https://clips.revu.lol http://localhost:8787 http://127.0.0.1:8787; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors https://twitter.com https://x.com https://*.twitter.com https://*.x.com

/clip.html
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-Jc9g/O4YwfbHrfQc0DF3SOxgZYJeOWpvzs4UCTBAGAg=' 'sha256-XXaGqM9Ae0HM6ryYkvvlFVZf5x2T9gcrh9VcvPETxWE='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src https://clips.revu.lol http://localhost:8787 http://127.0.0.1:8787; connect-src https://clips.revu.lol http://localhost:8787 http://127.0.0.1:8787; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors https://twitter.com https://x.com https://*.twitter.com https://*.x.com


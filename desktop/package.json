{
  "name": "revu-desktop",
  "productName": "Revu",
  "version": "4.4.0",
  "private": true,
  "type": "module",
  "description": "Revu desktop app: an Electron host and the local C# sidecar",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node scripts/start.mjs",
    "start:isolated": "node scripts/start.mjs --isolated",
    "start:recording-test": "node scripts/start-recording-test.mjs",
    "setup": "npm run runtime:install && npm run build:sidecar",
    "runtime:install": "node runtime/electron.mjs install",
    "runtime:check": "node runtime/electron.mjs inspect",
    "build:sidecar": "dotnet build ../src/Revu.Sidecar/Revu.Sidecar.csproj -c Release -p:Platform=x64 --artifacts-path ../artifacts/desktop-build",
    "recorder:setup": "node recorder/scripts/setup.mjs",
    "recorder:probe": "node recorder/scripts/probe.mjs",
    "test": "node --test tests/*.test.mjs electron/test/*.test.mjs runtime/test/*.test.mjs",
    "test:platform": "node --test tests/*.test.mjs",
    "package:dir": "node scripts/package.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "electron": "42.7.1",
    "electron-builder": "26.18.0",
    "rcedit": "5.0.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "builder-util-runtime": "9.7.0",
    "global-agent": "4.1.3"
  }
}
